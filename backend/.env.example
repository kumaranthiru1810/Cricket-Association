PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/cricket_db
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
FRONTEND_URL=http://localhost:8081

# Special Development Admin Bypass (Configurable & Isolated)
DEV_ADMIN_EMAIL=dev-admin@localhost.test
DEV_ADMIN_OTP=CHANGE_ME_dev_otp
DEV_ADMIN_BYPASS=false

# Nodemailer / SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your_smtp_user@yourdomain.com"
SMTP_PASSWORD="your_gmail_app_password_here"
SMTP_FROM="Cricket Federation" <notifications@yourdomain.com>

# Email Provider & Failover
EMAIL_PROVIDER=brevo
EMAIL_FALLBACK_PROVIDER=resend
ADMIN_ALERT_EMAIL=admin@yourdomain.com

# Cloudflare Turnstile Bot Protection
TURNSTILE_SECRET=
TURNSTILE_SITE_KEY=

# Cloudinary Image Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
