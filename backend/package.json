{
  "name": "cricket-backend",
  "version": "1.0.0",
  "description": "Cricket Federation Full-Stack Scorer and Management REST API Backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "node migrations/migrate.js",
    "seed": "node seeds/seed.js",
    "seed:settings": "node scripts/importMasterSettings.js",
    "test": "NODE_ENV=test node tests/runTests.js && NODE_ENV=test node tests/test_cricket_logic_fixes.js && NODE_ENV=test node tests/test_security_audit.js && NODE_ENV=test node tests/test_phase3_speed.js && NODE_ENV=test node tests/test_validation_errors.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test:rules": "node tests/test_cricket_rules_engine.js",
    "test:umpire": "node tests/test_umpire_module.js",
    "test:security": "node tests/securityVerification.js",
    "view-db": "node scripts/viewDb.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^7.7.0",
    "mongoose": "^9.10.4",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "nodemailer": "^10.0.13",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "chokidar": "^5.0.0",
    "eslint": "^10.15.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.10.1"
  },
  "overrides": {
    "braces": "^3.0.3"
  }
}
