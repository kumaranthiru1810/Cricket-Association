# =================================================================
# Backend Production Environment Variables Example
# Safe placeholders only - Never commit real credentials!
# =================================================================

# Server Environment
NODE_ENV=production
PORT=5000

# MongoDB Database Connection (with authentication enabled)
# Format: mongodb://<user>:<password>@<host>:<port>/<dbname>?authSource=admin
MONGODB_URI=mongodb://cricket_admin:ChangeThisStrongPassword123!@mongodb:27017/cricket_db?authSource=admin

# JWT Authentication Secret (Minimum 32 random characters)
JWT_SECRET=production_super_strong_jwt_secret_token_32_chars_min_replace_me!

# Initial Super Admin Account Seed (Provisioned on initial startup if no admin exists)
ADMIN_INITIAL_EMAIL=superadmin@yourdomain.com
ADMIN_INITIAL_PASSWORD=ChangeThisAdminPasswordImmediately123!

# Frontend Application Origin & CORS Configuration
FRONTEND_URL=https://cricket.yourdomain.com
ALLOWED_ORIGINS=https://cricket.yourdomain.com,https://admin.cricket.yourdomain.com

# Cloudflare Turnstile Bot Protection Secret (Mandatory in production)
TURNSTILE_SECRET=0x4AAAAAAA_your_cloudflare_turnstile_secret_here

# Email Provider Configuration ('brevo' | 'resend' | 'smtp')
EMAIL_PROVIDER=brevo

# Transactional HTTPS Email APIs (Recommended for cloud/PaaS environments)
# Brevo (Sendinblue) HTTPS API (Port 443 - no port blocks)
BREVO_API_KEY=xkeysib-your-brevo-api-key-here
BREVO_SENDER_EMAIL=notifications@yourdomain.com

# Resend HTTPS API (Alternative HTTPS transactional provider)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM=Cricket Federation <notifications@yourdomain.com>

# Standard SMTP Configuration
# Port 465 -> SSL/TLS (SMTP_SECURE=true)
# Port 587 -> STARTTLS (SMTP_SECURE=false)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASSWORD=your_sendgrid_api_key_or_smtp_password
SMTP_FROM="Cricket Federation" <notifications@yourdomain.com>

# File Upload Storage Directory
UPLOAD_DIR=/app/uploads

# Logging Level ('debug' | 'info' | 'warn' | 'error')
LOG_LEVEL=info

